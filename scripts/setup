#!/bin/zsh
set -eu
cd "${0:A:h:h}"
if [[ "$(uname -s)" != Darwin || "$(uname -m)" != arm64 ]]; then
    print "当前版本需要 Apple Silicon Mac。"
    exit 1
fi
lectureflow_os_major="$(sw_vers -productVersion | cut -d. -f1)"
if (( lectureflow_os_major < 26 )); then
    print "当前固定版本的本地推理依赖要求 macOS 26 以上。"
    exit 1
fi
zsh scripts/dev
if [[ "${1:-}" == "--all-models" ]]; then
    .venv/bin/lectureflow fetch asr-small translate asr-large
else
    .venv/bin/lectureflow fetch asr-small translate
fi
zsh scripts/build-app
print "安装完成。运行 zsh scripts/run 打开 LectureFlow。"
