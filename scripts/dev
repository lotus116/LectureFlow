#!/bin/zsh
set -eu
cd "${0:A:h:h}"
export UV_CACHE_DIR="$PWD/.cache/uv"
export UV_PYTHON_INSTALL_DIR="$PWD/.tools/python"
if [[ ! -x .tools/bin/uv ]]; then
    python3 -m pip install --disable-pip-version-check --target .tools uv==0.9.7
fi
.tools/bin/uv sync --frozen --extra models --extra dev --python 3.12
.venv/bin/ruff check src tests
.venv/bin/pytest -q
